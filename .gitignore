# --- OS Metadata Files ---
.DS_Store
Thumbs.db
Log.txt

# --- Development Tooling ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Node / Package Managers ---
# (Ignore if you use npm/yarn for local build tools or CSS processors)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Jekyll Specifics ---
# (GitHub Pages uses Jekyll by default. Ignore local build artifacts)
._site/
.jekyll-cache/
.jekyll-metadata

# --- Environment & Secrets ---
# NEVER commit API keys, passwords, or secrets to a public GH Pages repo
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env